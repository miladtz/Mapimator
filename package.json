{
  "name": "mapmotion-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:world": "node scripts/build-world-map.mjs dist-portable/natural-earth-50m src/data/worldMap.ts",
    "test:compatibility": "node scripts/verify-compatibility.mjs",
    "test:transitions": "node scripts/verify-transitions.mjs",
    "test:map-data": "node scripts/verify-world-map.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{md,json}\"",
    "test:pins": "node scripts/verify-pins.mjs",
    "test:layer-timeline": "node scripts/verify-layer-timeline.mjs",
    "test:segment-config": "node scripts/verify-segment-config.mjs",
    "test:layer-model": "node scripts/verify-layer-model.mjs",
    "test:timeline-entities": "node scripts/verify-timeline-entities.mjs",
    "test:editor-preview-modes": "node scripts/verify-editor-preview-modes.mjs",
    "test:map-mode": "node scripts/verify-map-mode.mjs",
    "test:segment-invariants": "node scripts/verify-segment-invariants.mjs",
    "test:milestone4-deep": "node scripts/verify-milestone4-deep.mjs",
    "test:preview-smoothness": "node scripts/verify-preview-smoothness.mjs",
    "test:save-export-runtime": "node scripts/verify-save-export-runtime.mjs",
    "test:export-render-stability": "node scripts/verify-export-render-stability.mjs",
    "test:camera-bearing": "node scripts/verify-camera-bearing.mjs",
    "benchmark:export-runtime": "node scripts/benchmark-export-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.5.3"
  }
}
